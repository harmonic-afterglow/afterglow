{
  "schema": "afterglow-remote/1",
  "id": "harmony-1100",
  "model": "Harmony 1100",
  "identity": {
    "arch": 11,
    "skin": 63,
    "other_skins": [
      62
    ],
    "flash": "0x01:0x49",
    "board": "0.3.0",
    "software_type": 0,
    "safe_mode_software_type": 4,
    "other_boards": [
      "0.5.0"
    ]
  },
  "payload": "pk",
  "backend": "harmony-pk",
  "status": "experimental",
  "notes": "Identity from a Logitech-generated configuration (skin 62) and firmware 62.7.7/63.7.7, which are byte-identical but for the skin: the same remote sold under two model numbers. Its board is 0.3.0 on the first configuration and 0.5.0 on a later one; both run that firmware. Every command is a recorded device sequence (docs/harmony_pk/ssir-sequences.md). Configurations can be read, imported and built; built ones have been written by testers. Writing one backs the remote up first. Its Safe Mode software type (4) is the 900's, the same firmware family; not yet seen on an 1100.",
  "capabilities": {
    "rf_blaster": false,
    "touchscreen": true,
    "ir_learning": true,
    "hard_keys": true
  },
  "infrared": {
    "native_protocols": [],
    "waveform": "carrier-period",
    "notes": "No protocol programs: the firmware plays stored sequences (IRQueue.lua ir_send_device_ir). playback=device-sequence makes the build render every command into press and hold sequences in SsIr.bin, one variant per toggle state.",
    "playback": "device-sequence"
  },
