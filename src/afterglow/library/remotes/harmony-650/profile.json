  "interface": {
    "_comment": "No RF blasters, no owner name (nothing on the 650 shows it) and no preferences file; a theme folder instead. No Advanced pages: the device and activity properties they edit are the Harmony 900's, which the 650's builder does not read. Timing offers what the remote keeps - power-on and inter-device delays, the delay between digits, Always on. Languages are the ones the Harmony 650 backend has a catalogue for (backends/harmony_650/locale). The Favourites page offers no logos: no configuration Logitech built for these remotes has one, and the builder makes favourites by name.",
    "tabs": [
      "devices",
      "activities",
      "settings",
      "flash"
    ],
    "device_pages": [
      "search",
      "identity",
      "commands",
      "inputs",
      "timing"
    ],
    "type_icons": false,
    "favourite_logos": false,
    "favourites_button": "Favorite Channels",
    "screen_icons": false,
    "screen_grid": {"activity": [2, 2]},
    "activity_buttons": [
      ["Watch TV", "TV"],
      ["Watch a Movie", "Movie"],
      ["Listen to Music", "Music"]
    ],
    "activity_pages": [
