  "preferences": {
    "_comment": "MyHarmony's Remote Backlight Settings, kept in the configuration's wiring: GlowTime is the first timer whose list opens 1F E910, TiltSensor the 3F F101 that arms the sensor (backends/harmony_650 compose and importing).",
    "_note": "These are written into the configuration when you flash, as MyHarmony's Remote Backlight Settings were.",
    "backlight_timeout": {
      "compiled": true,
      "label": "Backlight timeout (s)",
      "default": "20",
      "range": [
