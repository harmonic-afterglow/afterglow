  },
  "payload": "pk",
  "backend": "harmony-pk",
  "status": "experimental",
  "notes": "Identity from a Logitech-generated configuration (skin 62) and firmware 62.7.7/63.7.7, which are byte-identical but for the skin: the same remote sold under two model numbers. Every command is a recorded device sequence (docs/harmony_pk/ssir-sequences.md). Configurations can be read, imported and built; a built one has not yet been written to a remote, so writing goes through the test-write flow, which backs the remote up first.",
  "capabilities": {
    "rf_blaster": false,
    "touchscreen": true,
    "ir_learning": true,
    "hard_keys": true
  },
  "infrared": {
    "native_protocols": [],
    "waveform": "carrier-period",
    "notes": "No protocol programs: the firmware plays stored sequences (IRQueue.lua ir_send_device_ir). playback=device-sequence makes the build render every command into press and hold sequences in SsIr.bin, one variant per toggle state.",
    "playback": "device-sequence"
  },
