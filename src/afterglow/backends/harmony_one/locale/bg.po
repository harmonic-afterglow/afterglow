#. Closes a firmware notice, bottom right; about 40 pixels
msgctxt "system.ok"
msgid "OK"
msgstr "OK"

#. Title of a firmware diagnostic screen: a screen's title, top left; about 96 pixels in the title font
#, python-brace-format
msgctxt "system.message"
msgid "System Message: {number}"
msgstr "Системно съобщение: {number}"

#. Firmware screen 0, one line per line break, centred; about 160 pixels a line
