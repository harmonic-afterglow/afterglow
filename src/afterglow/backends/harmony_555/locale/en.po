msgstr "Welcome to your\nremote."

#. An answer, bottom left: centred over its key at the bottom of the screen; about 30 pixels
msgctxt "answer.yes"
msgid "Yes"
msgstr "Yes"

#. An answer, bottom right: centred over its key at the bottom of the screen; about 30 pixels
msgctxt "answer.no"
msgid "No"
msgstr "No"

#. Closes a note, bottom left: centred over its key at the bottom of the screen; about 30 pixels
msgctxt "answer.ok"
msgid "OK"
msgstr "OK"

#. While an activity starts, on a line of its own above the activity's name; about 90 pixels
msgctxt "activity.starting"
msgid "Starting"
msgstr "Starting"

#. Help, above Yes and No; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
msgctxt "help.fixed"
msgid "Did that fix the problem?"
msgstr "Did that fix the problem?"

#. Help asks about each device an activity turns on; {device} is its name; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.is-on"
msgid "Is the {device} on?"
msgstr "Is the {device} on?"

#. Help asks again after sending its power; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.now-on"
msgid "Now is the {device} on?"
msgstr "Now is the {device} on?"

#. All Off's Help asks about each device; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.is-off"
msgid "Is the {device} off?"
msgstr "Is the {device} off?"

#. All Off's Help asks again after turning it off; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.now-off"
msgid "Now is the {device} off?"
msgstr "Now is the {device} off?"

#. Help asks about each input; {device} and {input} are names; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut. An import reads the input's name back from it, so keep both fields
#, python-brace-format
msgctxt "help.is-set"
msgid "Is the {device} set to the {input} input?"
msgstr "Is the {device} set to the {input} input?"

#. Help asks again after sending the input; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.now-set"
msgid "Now is the {device} set to the {input} input?"
msgstr "Now is the {device} set to the {input} input?"

#. Help asks about another of a device's states, such as its screen; {device}, {state} and {value} are names ("Is the TV Screen set to HDMI2?"); Help's question, centred; three lines of about 90 pixels, wrapped between words and cut. An import reads the value back from it, so keep the fields
#, python-brace-format
msgctxt "help.is-state"
msgid "Is the {device} {state} set to {value}?"
msgstr "Is the {device} {state} set to {value}?"

#. Help asks again after sending the state; Help's question, centred; three lines of about 90 pixels, wrapped between words and cut
#, python-brace-format
msgctxt "help.now-state"
msgid "Now is the {device} {state} set to {value}?"
msgstr "Now is the {device} {state} set to {value}?"

#. The title of an activity's or a device's Sound page; {name} is its name: a screen's title, top left; about 90 pixels in the title font, cut with '..'
#, python-brace-format
msgctxt "layout.sound"
