msgstr "{name} (Picture)"

#. Under a page of buttons when there is more than one, such as 1 OF 3; drawn 8 pixels high with no room above the capitals, so capitals and digits only, no accents; about 40 pixels
#, python-brace-format
msgctxt "page.counter"
msgid "{number} OF {count}"
msgstr "{number} OF {count}"
