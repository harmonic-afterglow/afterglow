{
  "schema": "afterglow-ir-protocol/1",
  "id": "nec-ext",
  "name": "NEC extended address",
  "modulation": {"kind": "carrier", "carrier_hz": 38000, "duty_cycle": 0.333333},
  "parameters": {
    "address_low": {"bits": 8},
    "address_high": {"bits": 8},
    "command": {"bits": 8}
  },
  "bursts": {
    "leader": [9000, -4500],
    "zero": [562, -562],
    "one": [562, -1686],
    "trailer": [562],
    "repeat_leader": [9000, -2250]
  },
  "alphabets": {
    "bits": {"bits_per_symbol": 1, "symbols": {"0": "zero", "1": "one"}}
  },
  "frames": {
    "press": {
      "segments": [
        {"burst": "leader"},
        {"field": "address_low", "order": "lsb"},
        {"field": "address_high", "order": "lsb"},
        {"field": "command", "order": "lsb"},
        {"field": "command", "order": "lsb", "transform": "invert"},
        {"burst": "trailer"}
      ],
      "minimum_period_us": 108000
    },
    "repeat": {
      "segments": [{"burst": "repeat_leader"}, {"burst": "trailer"}],
      "minimum_period_us": 108000
    }
  },
  "transmission": {
    "press": [{"frame": "press"}],
    "hold": [{"frame": "repeat"}],
    "release": []
  }
}
